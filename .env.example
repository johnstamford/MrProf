# Copy to .env (never commit .env). All values here are examples.
MONGODB_URI=mongodb://mongo:27017/mrprof

# Model provider (Feature 5). Credentials stay server-side only.
# LLM_PROVIDER=dummy uses the deterministic stub (no network, default).
# LLM_PROVIDER=openai-compatible uses Microsoft Agent Framework with an
# OpenAI-compatible chat endpoint (Claude via compat URL, OpenRouter, local).
LLM_PROVIDER=dummy
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_S=20
LLM_MAX_TOKENS=300

# Copy to .env (never commit .env). All values here are examples.
MONGODB_URI=mongodb://mongo:27017/mrprof

# Model provider (Feature 5). Credentials stay server-side only.
# LLM_PROVIDER=dummy uses the deterministic stub (no network, default).
# LLM_PROVIDER=openai-compatible uses Microsoft Agent Framework with an
# OpenAI-compatible chat endpoint (Claude via compat URL, OpenRouter, local).
LLM_PROVIDER=dummy
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=300
# Ask the endpoint for JSON directly (response_format json_object).
# Strict JSON+Pydantic validation applies either way; "off" disables the hint.
LLM_JSON_MODE=json_object
# Bounded thinking on the interview critical path (measured ~2x faster than
# the default ~1000 thinking tokens). "off" omits the hint for endpoints
# that reject it. The background extractor keeps full reasoning.
LLM_REASONING_EFFORT=minimal
# Extraction emits long JSON and runs in the background, so it gets its own
# generous bound (interviewer stays on LLM_TIMEOUT_S, the critical path).
LLM_EXTRACT_TIMEOUT_S=60
